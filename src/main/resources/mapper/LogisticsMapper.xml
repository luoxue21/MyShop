<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.sdust.shopping.mapper.LogisticsMapper">
    
    <resultMap id="BaseResultMap" type="cn.edu.sdust.shopping.entity.Logistics">
        <id column="logistics_id" property="logisticsId"/>
        <result column="order_id" property="orderId"/>
        <result column="logistics_no" property="logisticsNo"/>
        <result column="logistics_company" property="logisticsCompany"/>
        <result column="logistics_status" property="logisticsStatus"/>
        <result column="ship_time" property="shipTime"/>
        <result column="receive_time" property="receiveTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
    
    <sql id="Base_Column_List">
        logistics_id, order_id, logistics_no, logistics_company, logistics_status, ship_time, receive_time, create_time, update_time
    </sql>
    
    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM logistics
        WHERE logistics_id = #{logisticsId}
    </select>
    
    <select id="findByOrderId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM logistics
        WHERE order_id = #{orderId}
    </select>
    
    <select id="findAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM logistics
    </select>
    
    <insert id="insert" parameterType="cn.edu.sdust.shopping.entity.Logistics" useGeneratedKeys="true" keyProperty="logisticsId">
        INSERT INTO logistics (order_id, logistics_no, logistics_company, logistics_status, ship_time, receive_time)
        VALUES (#{orderId}, #{logisticsNo}, #{logisticsCompany}, #{logisticsStatus}, #{shipTime}, #{receiveTime})
    </insert>
    
    <update id="update" parameterType="cn.edu.sdust.shopping.entity.Logistics">
        UPDATE logistics
        <set>
            <if test="logisticsNo != null">logistics_no = #{logisticsNo},</if>
            <if test="logisticsCompany != null">logistics_company = #{logisticsCompany},</if>
            <if test="logisticsStatus != null">logistics_status = #{logisticsStatus},</if>
            <if test="shipTime != null">ship_time = #{shipTime},</if>
            <if test="receiveTime != null">receive_time = #{receiveTime},</if>
        </set>
        WHERE logistics_id = #{logisticsId}
    </update>
    
</mapper>
